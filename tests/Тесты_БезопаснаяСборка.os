#Использовать "../"
#Использовать asserts

// Безопасная сборка HTML (0.2.0): валидация имён атрибутов, сборка атрибутов,
// фильтрация схем URL для href и безопасная ссылка.

// --- ЭкранироватьЗначение ---

&Тест
Процедура ЗначениеЭкранируетсяИПриводитсяКСтроке() Экспорт

	Ожидаем.Что(СанитизацияHTML.ЭкранироватьЗначение("<b>&""'"))
		.Равно("&lt;b&gt;&amp;&quot;&#39;");
	Ожидаем.Что(СанитизацияHTML.ЭкранироватьЗначение(Неопределено), "Неопределено — пусто").Равно("");
	Ожидаем.Что(СанитизацияHTML.ЭкранироватьЗначение(42), "число приводится к строке").Равно("42");

КонецПроцедуры

// --- ИмяАтрибутаДопустимо ---

&Тест
Процедура ДопустимыеИменаАтрибутовПринимаются() Экспорт

	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо("class")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо("data-id")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо("aria-label")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо("h1")).ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОпасныеИменаАтрибутовОтклоняются() Экспорт

	// имя не спасти экранированием: пробел и `=` проходят сквозь него
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо("class onmouseover=alert(1)"),
		"пробел и = дали бы обработчик события").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо("1data"), "первый символ — не буква").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо("-lead")).ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо("имя"), "кириллица не в алфавите").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо("")).ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо(Неопределено)).ЭтоЛожь();

	Длинное = "a";
	Пока СтрДлина(Длинное) <= 64 Цикл
		Длинное = Длинное + "b";
	КонецЦикла;
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо(Длинное), "длиннее 64 символов").ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ИмяАтрибутаНеОбходитШаблон() Экспорт

	// проверка имени — регулярным выражением; эти случаи сторожат его флаги
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо(Символ(8490) + "ey"),
		"знак Кельвина — не латиница, хотя без учёта регистра равен k").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо("class" + Символы.ПС),
		"завершающий перевод строки").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо("id" + Символы.ПС + "onclick"),
		"перевод строки внутри").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо("data" + Символ(0)), "нулевой символ").ЭтоЛожь();

	Ровно64 = "a";
	Пока СтрДлина(Ровно64) < 64 Цикл
		Ровно64 = Ровно64 + "-";
	КонецЦикла;
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо(Ровно64), "ровно 64 символа").ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.ИмяАтрибутаДопустимо("Z9-"), "заглавные, цифры, дефис").ЭтоИстина();

КонецПроцедуры

// --- Атрибут / БулевАтрибут ---

&Тест
Процедура АтрибутСобираетсяСЭкранированиемЗначения() Экспорт

	Ожидаем.Что(СанитизацияHTML.Атрибут("title", "a<b>&""c"))
		.Равно(" title=""a&lt;b&gt;&amp;&quot;c""");
	Ожидаем.Что(СанитизацияHTML.Атрибут("class", ""), "пустое значение не печатается").Равно("");
	Ожидаем.Что(СанитизацияHTML.Атрибут("bad name", "x"), "недопустимое имя не печатается").Равно("");

КонецПроцедуры

&Тест
Процедура БулевАтрибутПечатаетсяТолькоПоИстине() Экспорт

	Ожидаем.Что(СанитизацияHTML.БулевАтрибут("disabled", Истина)).Равно(" disabled");
	Ожидаем.Что(СанитизацияHTML.БулевАтрибут("disabled", Ложь)).Равно("");
	Ожидаем.Что(СанитизацияHTML.БулевАтрибут("disabled", "истина"),
		"только настоящее Булево Истина").Равно("");
	Ожидаем.Что(СанитизацияHTML.БулевАтрибут("bad name", Истина)).Равно("");

КонецПроцедуры

// --- URLБезопасенДляHref ---

&Тест
Процедура БезопасныеАдресаПроходят() Экспорт

	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("http://example.com")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("https://example.com/a?b=c#d")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("mailto:dev@example.com")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("/relative/path")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("#anchor")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("?query=1")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("relative.html")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("docs/a:b"),
		"двоеточие после слеша — не схема").ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref(""), "пустой href безвреден").ЭтоИстина();

КонецПроцедуры

&Тест
Процедура ОпасныеСхемыОтклоняются() Экспорт

	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("javascript:alert(1)")).ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("JavaScript:alert(1)"), "регистр").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref(" javascript:alert(1)"), "ведущий пробел").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("java" + Символы.Таб + "script:alert(1)"),
		"таб внутри схемы").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("javascript&colon;alert(1)"),
		"именованная сущность вместо двоеточия").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("java&#09;script:alert(1)"),
		"числовая сущность-таб внутри схемы").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("data:text/html;base64,PHNjcmlwdD4=")).ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("vbscript:msgbox(1)")).ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("ftp://example.com"),
		"вне allowlist — отклоняется").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref(Неопределено)).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ГраничныеАдресаБыстрогоПути() Экспорт

	// адрес с "/", "#" или "?" в начале безопасен без раскодирования (0.2.1);
	// ожидания сняты с поведения 0.2.0
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("/a")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("/")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("#x")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("?q=javascript:"), "схема в запросе — не схема").ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("/%0Ajavascript:"), "схема в пути — не схема").ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("#javascript:alert(1)")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("/" + Символы.ПС + "javascript:x")).ЭтоИстина();
	// протокол-относительный адрес — внешний, но без своей схемы: пропускался и раньше
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("//evil.com")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("/\evil.com")).ЭтоИстина();
	// быстрый путь судит первый символ, а не любой: "/", "#", "?" в конце схему не спасают
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("javascript:x/")).ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("javascript:x#")).ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("javascript:x?")).ЭтоЛожь();

КонецПроцедуры

&Тест
Процедура ВедущиеСимволыСудятсяПолнойНормализацией() Экспорт

	// пробел, управляющий символ или сущность в начале — мимо быстрого пути
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref(" /a")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref(Символы.ПС + "/x")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref(" //evil.com")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("&#9;//evil.com")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("&#47;&#47;evil.com"), "слеши сущностями").ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("&sol;javascript:x"), "слеш сущностью до двоеточия").ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref(Символы.Таб + "javascript:x")).ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref(Символ(1) + "javascript:x")).ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("&#32;javascript:x"), "пробел сущностью").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref(Символ(8203) + "javascript:x"),
		"zero-width в схеме — схема вне allowlist").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("ja" + Символы.ПС + "vascript:x")).ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("javascript:/x"), "слеш после двоеточия").ЭтоЛожь();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("https&colon;//x")).ЭтоИстина();
	Ожидаем.Что(СанитизацияHTML.URLБезопасенДляHref("   "), "одни пробелы — пустой href").ЭтоИстина();

КонецПроцедуры

// --- Ссылка ---

&Тест
Процедура СсылкаРендеритсяДляБезопасногоАдреса() Экспорт

	Ожидаем.Что(СанитизацияHTML.Ссылка("https://e.com/a?b=1&c=2", "текст <b>", "cls"))
		.Равно("<a href=""https://e.com/a?b=1&amp;c=2"" class=""cls"">текст &lt;b&gt;</a>");
	Ожидаем.Что(СанитизацияHTML.Ссылка("/local", "внутрь"))
		.Равно("<a href=""/local"">внутрь</a>");

КонецПроцедуры

&Тест
Процедура СсылкаНеРендеритсяДляОпаснойСхемы() Экспорт

	Ожидаем.Что(СанитизацияHTML.Ссылка("javascript:alert(1)", "жми"),
		"опасная схема — только экранированный текст").Равно("жми");
	Ожидаем.Что(СанитизацияHTML.Ссылка("javascript:alert(1)", "жми", "cls"),
		"класс сохраняется на span").Равно("<span class=""cls"">жми</span>");
	Ожидаем.Что(СтрНайти(СанитизацияHTML.Ссылка("javascript:alert(1)", "<i>жми</i>"), "<i>"),
		"текст при отказе тоже экранируется").Равно(0);

КонецПроцедуры

&Тест
Процедура ДоверенныеВнутренностиНеЭкранируются() Экспорт

	Ожидаем.Что(СанитизацияHTML.Ссылка("/a", "не важно", "", "<svg/>иконка"))
		.Равно("<a href=""/a""><svg/>иконка</a>");

КонецПроцедуры
