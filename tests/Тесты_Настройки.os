#Использовать "../"
#Использовать "../src/internal"
#Использовать asserts

// Конфигурируемость: свои allowlist, управление протоколами и rel.
// Контракт конструктора санитайзера проверяется напрямую — отсюда internal.

&Тест
Процедура ПустыеНастройкиУбираютВсеТеги() Экспорт

	Настройки = СанитизацияHTML.ПустыеНастройки();
	Ожидаем.Что(СанитизацияHTML.Очистить("<p>текст <strong>жирный</strong></p>", Настройки))
		.Равно("текст жирный");

КонецПроцедуры

&Тест
Процедура СвойAllowlist() Экспорт

	Настройки = СанитизацияHTML.ПустыеНастройки()
		.РазрешитьТег("b")
		.РазрешитьТег("span", "title");

	Результат = СанитизацияHTML.Очистить("<b>ж</b><span title=""т"" class=""x"">с</span><p>абзац</p>", Настройки);
	Ожидаем.Что(Результат).Равно("<b>ж</b><span title=""т"">с</span>абзац");

КонецПроцедуры

&Тест
Процедура АтрибутыМассивом() Экспорт

	Атрибуты = Новый Массив;
	Атрибуты.Добавить("href");
	Атрибуты.Добавить("title");
	Настройки = СанитизацияHTML.ПустыеНастройки().РазрешитьТег("a", Атрибуты);

	Результат = СанитизацияHTML.Очистить("<a href=""/x"" title=""т"" id=""z"">с</a>", Настройки);
	Ожидаем.Что(Результат).Равно("<a href=""/x"" title=""т"">с</a>");

КонецПроцедуры

&Тест
Процедура ЗапретТегаИзПрофиля() Экспорт

	Настройки = СанитизацияHTML.НастройкиMarkdown().ЗапретитьТег("img");
	Результат = СанитизацияHTML.Очистить("<p>до <img src=""https://e/x.png""> после</p>", Настройки);
	Ожидаем.Что(Результат).Равно("<p>до  после</p>");

КонецПроцедуры

&Тест
Процедура УдалениеТегаССодержимымПоНастройке() Экспорт

	Настройки = СанитизацияHTML.НастройкиMarkdown().УдалятьТегССодержимым("blockquote");
	Результат = СанитизацияHTML.Очистить("<p>до</p><blockquote>цитата</blockquote><p>после</p>", Настройки);
	Ожидаем.Что(Результат).Равно("<p>до</p><p>после</p>");

КонецПроцедуры

&Тест
Процедура ОтключениеRel() Экспорт

	Настройки = СанитизацияHTML.НастройкиMarkdown().УстановитьRelВнешнихСсылок("");
	Результат = СанитизацияHTML.Очистить("<a href=""https://e.com"">x</a>", Настройки);
	Ожидаем.Что(Результат).Равно("<a href=""https://e.com"">x</a>");

КонецПроцедуры

&Тест
Процедура СвоеЗначениеRel() Экспорт

	Настройки = СанитизацияHTML.НастройкиMarkdown()
		.УстановитьRelВнешнихСсылок("nofollow noopener noreferrer");
	Результат = СанитизацияHTML.Очистить("<a href=""https://e.com"">x</a>", Настройки);
	Ожидаем.Что(Результат).Содержит("rel=""nofollow noopener noreferrer""");

КонецПроцедуры

&Тест
Процедура ДополнительныйПротокол() Экспорт

	Настройки = СанитизацияHTML.НастройкиMarkdown().РазрешитьПротокол("ftp");
	Результат = СанитизацияHTML.Очистить("<a href=""ftp://files.example/x"">x</a>", Настройки);
	Ожидаем.Что(Результат).Содержит("href=""ftp://files.example/x""");

КонецПроцедуры

&Тест
Процедура ЗапретПротокола() Экспорт

	Настройки = СанитизацияHTML.НастройкиMarkdown().ЗапретитьПротокол("http");
	Ожидаем.Что(СанитизацияHTML.Очистить("<a href=""http://e.com"">x</a>", Настройки)).Равно("<a>x</a>");
	Ожидаем.Что(СанитизацияHTML.Очистить("<a href=""https://e.com"">x</a>", Настройки))
		.Содержит("href=""https://e.com""");

КонецПроцедуры

&Тест
Процедура РазрешениеРанееОпасногоТега() Экспорт

	// разрешение тега снимает с него пометку "удалять с содержимым"
	Настройки = СанитизацияHTML.НастройкиMarkdown().РазрешитьТег("form");
	Результат = СанитизацияHTML.Очистить("<form action=""x"">содержимое</form>", Настройки);
	Ожидаем.Что(Результат).Равно("<form>содержимое</form>");

КонецПроцедуры

&Тест
Процедура НекорректныйКлассКодаУдаляется() Экспорт

	Ожидаем.Что(СанитизацияHTML.Очистить("<code class=""evil"">x</code>")).Равно("<code>x</code>");
	Ожидаем.Что(СанитизацияHTML.Очистить("<code class=""language-"">x</code>")).Равно("<code>x</code>");
	Ожидаем.Что(СанитизацияHTML.Очистить("<code class=""language-js evil"">x</code>")).Равно("<code>x</code>");
	Ожидаем.Что(СанитизацияHTML.Очистить("<code class=""language-c++"">x</code>"))
		.Равно("<code class=""language-c++"">x</code>");

КонецПроцедуры

&Тест
Процедура НекорректноеВыравниваниеУдаляется() Экспорт

	Ожидаем.Что(СанитизацияHTML.Очистить("<table><tr><td align=""evil"">x</td></tr></table>"))
		.Равно("<table><tr><td>x</td></tr></table>");

КонецПроцедуры

&Тест
Процедура СанитайзерТребуетНастройки() Экспорт

	Ошибка = Ложь;
	Попытка
		Санитайзер = Новый СанитайзерHTML("не настройки");
	Исключение
		Ошибка = Истина;
	КонецПопытки;
	Ожидаем.Что(Ошибка).ЭтоИстина();

КонецПроцедуры
