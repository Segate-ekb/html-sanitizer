// СанитизацияHTML — фасад библиотеки html-sanitizer и её единственный
// публичный интерфейс. Токенизатор, санитайзер, настройки и сущности лежат
// в src/internal и меняются без оглядки на обратную совместимость.
//
// Быстрый старт:
//   Безопасный = СанитизацияHTML.Очистить(НедовереннныйHTML);
//
// Свой allowlist:
//   Настройки = СанитизацияHTML.ПустыеНастройки()
//       .РазрешитьТег("p")
//       .РазрешитьТег("a", "href, title");
//   Безопасный = СанитизацияHTML.Очистить(HTML, Настройки);

#Использовать "../internal"

Перем мШаблонИмениАтрибута; // РегулярноеВыражение: см. ИмяАтрибутаДопустимо

// Санитизирует HTML по allowlist.
//
// Параметры:
//   HTML      - Строка - недоверенный HTML
//   Настройки - НастройкиСанитизации - allowlist; по умолчанию — профиль
//               для markdown-вывода (НастройкиMarkdown)
//
// Возвращаемое значение:
//   Строка - безопасный HTML
Функция Очистить(Знач HTML, Знач Настройки = Неопределено) Экспорт

	Если Настройки = Неопределено Тогда
		Настройки = НастройкиMarkdown();
	КонецЕсли;

	Санитайзер = Новый СанитайзерHTML(Настройки);
	Возврат Санитайзер.Очистить(HTML);

КонецФункции

// Профиль по умолчанию: теги, которые порождает типичный markdown-рендер
// (в т.ч. oscript-md) — абзацы, заголовки, списки, ссылки, изображения,
// код, таблицы, details/summary.
//
// Возвращаемое значение:
//   НастройкиСанитизации - настроенный allowlist (можно дорабатывать цепочкой)
Функция НастройкиMarkdown() Экспорт

	Настройки = Новый НастройкиСанитизации;

	Настройки
		.РазрешитьТег("p")
		.РазрешитьТег("br")
		.РазрешитьТег("hr")
		.РазрешитьТег("h1")
		.РазрешитьТег("h2")
		.РазрешитьТег("h3")
		.РазрешитьТег("h4")
		.РазрешитьТег("h5")
		.РазрешитьТег("h6")
		.РазрешитьТег("ul")
		.РазрешитьТег("ol")
		.РазрешитьТег("li")
		.РазрешитьТег("strong")
		.РазрешитьТег("em")
		.РазрешитьТег("code", "class")
		.РазрешитьТег("pre", "class")
		.РазрешитьТег("blockquote")
		.РазрешитьТег("a", "href, title")
		.РазрешитьТег("img", "src, alt, title")
		.РазрешитьТег("table")
		.РазрешитьТег("thead")
		.РазрешитьТег("tbody")
		.РазрешитьТег("tr")
		.РазрешитьТег("th", "align")
		.РазрешитьТег("td", "align")
		.РазрешитьТег("details")
		.РазрешитьТег("summary");

	Возврат Настройки;

КонецФункции

// Пустой allowlist: ни один тег не разрешён, весь HTML экранируется
// или удаляется. Основа для полностью своего профиля.
//
// Возвращаемое значение:
//   НастройкиСанитизации
Функция ПустыеНастройки() Экспорт

	Возврат Новый НастройкиСанитизации;

КонецФункции

// Экранирует текст для безопасной вставки в HTML (без разрешённых тегов вовсе).
//
// Параметры:
//   Текст - Строка - произвольный текст
//
// Возвращаемое значение:
//   Строка - экранированный текст
Функция ЭкранироватьТекст(Знач Текст) Экспорт

	Возврат СущностиHTML.Экранировать(Текст);

КонецФункции

// ---------------------------------------------------------------------------
// Безопасная сборка HTML: атрибуты и ссылки (появилось в 0.2.0).
//
// Перенесено из желудя ЭкранированиеHTML хаба OpenHub: правила «имя атрибута
// ВАЛИДИРУЕТСЯ, а не экранируется» и «href фильтруется по allowlist схем» —
// предметная область санитайзера, а не веб-приложения.
// ---------------------------------------------------------------------------

// Экранирует произвольное значение для безопасной вставки в HTML.
// В отличие от ЭкранироватьТекст принимает НЕ ТОЛЬКО строки: Неопределено даёт
// пустую строку, прочие значения приводятся к строке.
//
// Параметры:
//   Значение - Произвольный - значение для вывода
//
// Возвращаемое значение:
//   Строка - экранированный текст
Функция ЭкранироватьЗначение(Знач Значение) Экспорт

	Если Значение = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат СущностиHTML.Экранировать(Строка(Значение));

КонецФункции

// Допустимо ли имя атрибута: `[A-Za-z][A-Za-z0-9-]*`, не длиннее 64 символов.
//
// Имя атрибута нельзя СПАСТИ экранированием: `&lt; &gt; &amp; " '` заменяются, а
// ПРОБЕЛ и `=` проходят насквозь, поэтому имя «class onmouseover=alert(1)» дало бы
// браузеру полноценный обработчик события. Латиницы, цифр и дефиса хватает и на
// data-атрибуты, и на aria-*; всё прочее — ошибка разметки.
//
// Параметры:
//   Имя - Произвольный - проверяемое имя
//
// Возвращаемое значение:
//   Булево - Истина, если имя безопасно печатать без экранирования
Функция ИмяАтрибутаДопустимо(Знач Имя) Экспорт

	Если НЕ ЗначениеЗаполнено(Имя) Тогда
		Возврат Ложь;
	КонецЕсли;

	Если мШаблонИмениАтрибута = Неопределено Тогда
		мШаблонИмениАтрибута = НовыйШаблонИмениАтрибута();
	КонецЕсли;

	Возврат мШаблонИмениАтрибута.Совпадает(Строка(Имя));

КонецФункции

// Атрибут тега вида ` имя="значение"` с ведущим пробелом. Пустое значение или
// недопустимое имя (см. ИмяАтрибутаДопустимо) — пустая строка: атрибут не печатается.
//
// Параметры:
//   Имя      - Строка       - имя атрибута
//   Значение - Произвольный - значение атрибута
//
// Возвращаемое значение:
//   Строка - фрагмент атрибута с ведущим пробелом либо ""
Функция Атрибут(Знач Имя, Знач Значение) Экспорт

	Если НЕ ЗначениеЗаполнено(Значение) ИЛИ НЕ ИмяАтрибутаДопустимо(Имя) Тогда
		Возврат "";
	КонецЕсли;

	Возврат СтрШаблон(" %1=""%2""", Имя, ЭкранироватьЗначение(Значение));

КонецФункции

// Булев атрибут (disabled, required, checked, ...): печатается только когда Условие
// истинно И имя атрибута допустимо.
//
// Параметры:
//   Имя     - Строка - имя атрибута
//   Условие - Булево - печатать ли атрибут
//
// Возвращаемое значение:
//   Строка - " имя" либо ""
Функция БулевАтрибут(Знач Имя, Знач Условие) Экспорт

	Если Условие = Истина И ИмяАтрибутаДопустимо(Имя) Тогда
		Возврат " " + Имя;
	КонецЕсли;

	Возврат "";

КонецФункции

// Допустим ли URL как значение href: allowlist схем (http/https/mailto) либо
// относительный/якорный адрес.
//
// HTML-экранирование href НЕ нейтрализует опасную схему — javascript:/data:/vbscript:
// браузер выполнит. Обфускации нейтрализуются нормализацией:
//   1) декодирование HTML-сущностей (СущностиHTML.Раскодировать) — «сущности внутри
//      схемы» вида "java&#09;script:" / "javascript&colon;" сводятся к реальным символам;
//   2) удаление пробелов и управляющих символов (код <= 32) — браузер их игнорирует
//      внутри схемы ("java\tscript:", " javascript:");
//   3) нижний регистр ("JavaScript:").
//
// Адрес, который начинается с "/", "#" или "?", — путь, якорь или запрос без схемы:
// он безопасен сразу, без раскодирования. Сюда же относится протокол-относительный
// "//host" (и "/\host"): внешний адрес, но со схемой страницы — так было и до 0.2.1.
// Ведущий пробел, управляющий символ или сущность быстрый путь не проходят и
// судятся полной нормализацией.
//
// Параметры:
//   Адрес - Произвольный - проверяемый URL
//
// Возвращаемое значение:
//   Булево - Истина, если адрес безопасен для вывода как href
Функция URLБезопасенДляHref(Знач Адрес) Экспорт

	Если Адрес = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;

	Исходный = Строка(Адрес);
	Первый = Лев(Исходный, 1);
	Если Первый = "/" ИЛИ Первый = "#" ИЛИ Первый = "?" Тогда
		Возврат Истина; // относительный/якорный/query — без схемы
	КонецЕсли;

	// Решение зависит только от части до первого двоеточия: удаление символов
	// с кодом <= 32 и нижний регистр не добавляют и не убирают ни ":", ни "/?#".
	// Пустой (после нормализации) адрес двоеточия не содержит — он безвреден.
	Исходный = СущностиHTML.Раскодировать(Исходный);
	ПозицияДвоеточия = СтрНайти(Исходный, ":");
	Если ПозицияДвоеточия = 0 Тогда
		Возврат Истина; // нет схемы — относительный URL (или пустой href)
	КонецЕсли;

	Схема = НРег(УправляющиеСимволы.УдалитьПробелыИУправляющие(Лев(Исходный, ПозицияДвоеточия - 1)));

	// двоеточие в пути/запросе/фрагменте — схемы нет
	Если СтрНайти(Схема, "/") > 0 ИЛИ СтрНайти(Схема, "?") > 0 ИЛИ СтрНайти(Схема, "#") > 0 Тогда
		Возврат Истина;
	КонецЕсли;

	Возврат Схема = "http" ИЛИ Схема = "https" ИЛИ Схема = "mailto";

КонецФункции

// Ссылка `<a href>` с экранированием адреса и текста и фильтрацией схемы URL
// (URLБезопасенДляHref). При небезопасной схеме ссылка НЕ рендерится: выводится
// экранированный текст (в `<span>` с классом, если класс задан).
//
// Параметры:
//   Адрес        - Строка - URL
//   Текст        - Строка - видимый текст ссылки
//   Класс        - Строка - необязательный CSS-класс
//   Внутренности - Строка - необязательный ДОВЕРЕННЫЙ HTML вместо текста
//                  (например иконка + подпись, собранные вызывающим)
//
// Возвращаемое значение:
//   Строка - HTML-фрагмент ссылки либо экранированный текст (для небезопасной схемы)
Функция Ссылка(Знач Адрес, Знач Текст, Знач Класс = "", Знач Внутренности = Неопределено) Экспорт

	Содержимое = ?(Внутренности = Неопределено, ЭкранироватьЗначение(Текст), Внутренности);

	Если НЕ URLБезопасенДляHref(Адрес) Тогда
		Если ЗначениеЗаполнено(Класс) Тогда
			Возврат СтрШаблон("<span%1>%2</span>", Атрибут("class", Класс), Содержимое);
		КонецЕсли;
		Возврат Содержимое;
	КонецЕсли;

	Возврат СтрШаблон("<a href=""%1""%2>%3</a>",
		ЭкранироватьЗначение(Адрес), Атрибут("class", Класс), Содержимое);

КонецФункции

#Область Служебные

// Шаблон имени атрибута `[A-Za-z][A-Za-z0-9-]*` длиной до 64 — одна проверка
// вместо посимвольного цикла (имя проверяется на каждый печатаемый атрибут).
// Регистр учитывается: без этого .NET сопоставил бы [A-Za-z] и знаку Кельвина
// U+212A. `\z` — строго конец строки: `$` пропустил бы завершающий перевод строки.
// Объект создаётся один раз на процесс; одновременное создание в двух потоках
// безвредно — сопоставление у РегулярноеВыражение потокобезопасно.
Функция НовыйШаблонИмениАтрибута()

	Шаблон = Новый РегулярноеВыражение("^[A-Za-z][A-Za-z0-9-]{0,63}\z");
	Шаблон.ИгнорироватьРегистр = Ложь;
	Шаблон.Многострочный = Ложь;
	Возврат Шаблон;

КонецФункции

#КонецОбласти
