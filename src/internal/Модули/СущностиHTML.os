// СущностиHTML — раскодирование и экранирование HTML-сущностей.
//
// Раскодирование выполняется ровно один раз (без рекурсии) — так же, как это
// делает браузер: "&amp;#106;" превращается в "&#106;" и дальше не трактуется
// как сущность. Это важно для корректного распознавания обфусцированных URL.

Перем СловарьИменованных; // Соответствие: имя сущности (с учётом регистра) -> символ
Перем ИменованныеLegacy;  // Соответствие: legacy-имя без точки с запятой (нижний регистр) -> символ

// Раскодирует HTML-сущности в строке за один проход.
// Поддерживаются числовые сущности (&#106; &#x6A; в т.ч. без точки с запятой
// и с ведущими нулями) и распространённые именованные (&amp; &lt; &colon; &Tab; ...).
// Нераспознанные сущности остаются как есть.
//
// Параметры:
//   Текст - Строка - исходный текст
//
// Возвращаемое значение:
//   Строка - текст с раскодированными сущностями
Функция Раскодировать(Знач Текст) Экспорт

	Если СтрНайти(Текст, "&") = 0 Тогда
		Возврат Текст;
	КонецЕсли;

	Результат = Новый Массив;
	Длина = СтрДлина(Текст);
	Позиция = 1;

	Пока Позиция <= Длина Цикл

		ПозицияАмперсанда = СтрНайти(Текст, "&", НаправлениеПоиска.СНачала, Позиция);
		Если ПозицияАмперсанда = 0 Тогда
			Результат.Добавить(Сред(Текст, Позиция));
			Прервать;
		КонецЕсли;

		Если ПозицияАмперсанда > Позиция Тогда
			Результат.Добавить(Сред(Текст, Позиция, ПозицияАмперсанда - Позиция));
		КонецЕсли;

		// частые в выводе Markdown сущности — без общего разбора (итог тот же)
		Если Сред(Текст, ПозицияАмперсанда, 5) = "&amp;" Тогда
			Результат.Добавить("&");
			Позиция = ПозицияАмперсанда + 5;
		ИначеЕсли Сред(Текст, ПозицияАмперсанда, 4) = "&lt;" Тогда
			Результат.Добавить("<");
			Позиция = ПозицияАмперсанда + 4;
		ИначеЕсли Сред(Текст, ПозицияАмперсанда, 4) = "&gt;" Тогда
			Результат.Добавить(">");
			Позиция = ПозицияАмперсанда + 4;
		ИначеЕсли Сред(Текст, ПозицияАмперсанда, 6) = "&quot;" Тогда
			Результат.Добавить("""");
			Позиция = ПозицияАмперсанда + 6;
		Иначе
			Разбор = РазобратьСущность(Текст, ПозицияАмперсанда, Длина);
			Результат.Добавить(Разбор.Значение);
			Позиция = Разбор.НоваяПозиция;
		КонецЕсли;

	КонецЦикла;

	Возврат СтрСоединить(Результат, "");

КонецФункции

// Экранирует спецсимволы HTML для безопасного вывода.
//
// Параметры:
//   Текст - Строка - исходный текст
//
// Возвращаемое значение:
//   Строка - текст, безопасный для вставки в HTML (и в текст, и в значение атрибута)
Функция Экранировать(Знач Текст) Экспорт

	Текст = СтрЗаменить(Текст, "&", "&amp;");
	Текст = СтрЗаменить(Текст, "<", "&lt;");
	Текст = СтрЗаменить(Текст, ">", "&gt;");
	Текст = СтрЗаменить(Текст, """", "&quot;");
	Текст = СтрЗаменить(Текст, "'", "&#39;");

	Возврат Текст;

КонецФункции

#Область Служебные

Функция РазобратьСущность(Знач Текст, Знач Позиция, Знач Длина)

	// Позиция указывает на "&"
	Если Сред(Текст, Позиция + 1, 1) = "#" Тогда
		Возврат РазобратьЧисловуюСущность(Текст, Позиция, Длина);
	КонецЕсли;

	Возврат РазобратьИменованнуюСущность(Текст, Позиция, Длина);

КонецФункции

Функция РазобратьЧисловуюСущность(Знач Текст, Знач Позиция, Знач Длина)

	ПризнакHex = НРег(Сред(Текст, Позиция + 2, 1)) = "x";
	НачалоЦифр = Позиция + ?(ПризнакHex, 3, 2);
	ЦифрыHex = "0123456789abcdef";
	Основание = ?(ПризнакHex, 16, 10);

	Код = 0;
	КоличествоЦифр = 0;
	Текущая = НачалоЦифр;
	Пока Текущая <= Длина И КоличествоЦифр < 8 Цикл
		Цифра = СтрНайти(ЦифрыHex, НРег(Сред(Текст, Текущая, 1)));
		Если Цифра = 0 Или Цифра > Основание Тогда
			Прервать;
		КонецЕсли;
		Код = Код * Основание + (Цифра - 1);
		КоличествоЦифр = КоличествоЦифр + 1;
		Текущая = Текущая + 1;
	КонецЦикла;

	Если КоличествоЦифр = 0 Тогда
		// не сущность — вернуть "&" как обычный символ
		Возврат Новый Структура("Значение, НоваяПозиция", "&", Позиция + 1);
	КонецЕсли;

	КонечнаяПозиция = Текущая;
	Если Сред(Текст, КонечнаяПозиция, 1) = ";" Тогда
		КонечнаяПозиция = КонечнаяПозиция + 1;
	КонецЕсли;

	Если Код <= 0 Или Код > 65535 Или (Код >= 55296 И Код <= 57343) Тогда
		// вне поддерживаемого диапазона (в т.ч. суррогаты) — оставить как есть
		Исходное = Сред(Текст, Позиция, КонечнаяПозиция - Позиция);
		Возврат Новый Структура("Значение, НоваяПозиция", Исходное, КонечнаяПозиция);
	КонецЕсли;

	Возврат Новый Структура("Значение, НоваяПозиция", Символ(Код), КонечнаяПозиция);

КонецФункции

Функция РазобратьИменованнуюСущность(Знач Текст, Знач Позиция, Знач Длина)

	СимволыИмени = "abcdefghijklmnopqrstuvwxyz0123456789";
	НачалоИмени = Позиция + 1;
	Текущая = НачалоИмени;
	Пока Текущая <= Длина И (Текущая - НачалоИмени) < 32 Цикл
		Если СтрНайти(СимволыИмени, НРег(Сред(Текст, Текущая, 1))) = 0 Тогда
			Прервать;
		КонецЕсли;
		Текущая = Текущая + 1;
	КонецЦикла;

	Имя = Сред(Текст, НачалоИмени, Текущая - НачалоИмени);
	Если Имя = "" Тогда
		Возврат Новый Структура("Значение, НоваяПозиция", "&", Позиция + 1);
	КонецЕсли;

	ЕстьТочкаСЗапятой = Сред(Текст, Текущая, 1) = ";";

	Если ЕстьТочкаСЗапятой Тогда
		Значение = Словарь().Получить(Имя);
		Если Значение = Неопределено Тогда
			Значение = Словарь().Получить(НРег(Имя));
		КонецЕсли;
		Если Значение <> Неопределено Тогда
			Возврат Новый Структура("Значение, НоваяПозиция", Значение, Текущая + 1);
		КонецЕсли;
		// неизвестная сущность — оставить как есть
		Исходное = Сред(Текст, Позиция, Текущая - Позиция + 1);
		Возврат Новый Структура("Значение, НоваяПозиция", Исходное, Текущая + 1);
	КонецЕсли;

	// без точки с запятой браузеры раскодируют только legacy-сущности;
	// имя может начинаться с цифры ("&1"), поэтому поиск — в соответствии,
	// а не в структуре: Свойство("1") бросило бы исключение
	ЗначениеLegacy = СловарьLegacy().Получить(НРег(Имя));
	Если ЗначениеLegacy <> Неопределено Тогда
		Возврат Новый Структура("Значение, НоваяПозиция", ЗначениеLegacy, Текущая);
	КонецЕсли;

	Исходное = Сред(Текст, Позиция, Текущая - Позиция);
	Возврат Новый Структура("Значение, НоваяПозиция", Исходное, Текущая);

КонецФункции

// Словари собираются в локальной переменной и публикуются готовыми: модуль общий
// для потоков, и поток, заставший словарь, не должен видеть его недособранным.
Функция Словарь()

	Если СловарьИменованных = Неопределено Тогда
		СловарьИменованных = НовыйСловарь();
	КонецЕсли;

	Возврат СловарьИменованных;

КонецФункции

Функция СловарьLegacy()

	Если ИменованныеLegacy = Неопределено Тогда
		Legacy = Новый Соответствие;
		Legacy.Вставить("amp", "&");
		Legacy.Вставить("lt", "<");
		Legacy.Вставить("gt", ">");
		Legacy.Вставить("quot", """");
		Legacy.Вставить("nbsp", Символ(160));
		ИменованныеLegacy = Legacy;
	КонецЕсли;

	Возврат ИменованныеLegacy;

КонецФункции

Функция НовыйСловарь()

	Результат = Новый Соответствие;
	Результат.Вставить("amp", "&");
	Результат.Вставить("lt", "<");
	Результат.Вставить("gt", ">");
	Результат.Вставить("quot", """");
	Результат.Вставить("apos", "'");
	Результат.Вставить("nbsp", Символ(160));
	// сущности, применяемые для обфускации URL
	Результат.Вставить("colon", ":");
	Результат.Вставить("semi", ";");
	Результат.Вставить("sol", "/");
	Результат.Вставить("bsol", "\");
	Результат.Вставить("num", "#");
	Результат.Вставить("quest", "?");
	Результат.Вставить("equals", "=");
	Результат.Вставить("percnt", "%");
	Результат.Вставить("commat", "@");
	Результат.Вставить("Tab", Символы.Таб);
	Результат.Вставить("NewLine", Символы.ПС);
	// типографика, частая в текстах README
	Результат.Вставить("mdash", Символ(8212));
	Результат.Вставить("ndash", Символ(8211));
	Результат.Вставить("hellip", Символ(8230));
	Результат.Вставить("laquo", Символ(171));
	Результат.Вставить("raquo", Символ(187));
	Результат.Вставить("copy", Символ(169));
	Результат.Вставить("reg", Символ(174));
	Результат.Вставить("trade", Символ(8482));
	Результат.Вставить("deg", Символ(176));
	Результат.Вставить("middot", Символ(183));
	Результат.Вставить("bull", Символ(8226));
	Результат.Вставить("sect", Символ(167));
	Результат.Вставить("para", Символ(182));
	Результат.Вставить("plusmn", Символ(177));
	Результат.Вставить("times", Символ(215));
	Результат.Вставить("divide", Символ(247));

	Возврат Результат;

КонецФункции

#КонецОбласти
