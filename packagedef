Описание.Имя("html-sanitizer")
		.Версия("0.2.1")
		.Автор("OpenHub")
		.Описание("Санитизация HTML по принципу allowlist: фильтрация тегов, атрибутов и протоколов URL для безопасного отображения недоверенного HTML (например, отрендеренного из Markdown)")
		.ВерсияСреды("2.0.0")

		.РазработкаЗависитОт("asserts", "1.6.0")
		.РазработкаЗависитОт("oneunit", "0.4.0")

		.ОпределяетМодуль("СанитизацияHTML", "src/Модули/СанитизацияHTML.os")

		.ВключитьФайл("packagedef")
		.ВключитьФайл("src")
		.ВключитьФайл("README.md")
		.ВключитьФайл("LICENSE");
